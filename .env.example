# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in values from your Supabase project.
# NEVER commit .env or any real key to GitHub. .gitignore already excludes it.
# ---------------------------------------------------------------------------

# Supabase project URL (Settings -> API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase anon/public key (safe for browser). NEVER use the service_role key here.
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# Edge Function URL base. Usually: https://YOUR_PROJECT_REF.supabase.co/functions/v1
VITE_SUPABASE_FUNCTIONS_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1

# Demo preview mode (see SETUP_GUIDE.md).
# true  = browse a clearly-badged in-memory catalogue preview without a backend.
# false = use real Supabase backend (required for auth, cart, orders, uploads).
VITE_DEMO_MODE=false

# Public storefront configuration (safe to expose)
VITE_STORE_NAME=Norwood & Co.
VITE_STORE_TAGLINE=Thoughtful goods, close to home.
VITE_STORE_EMAIL=hello@norwoodandco.example
VITE_STORE_PHONE=+1 (555) 010-2040
